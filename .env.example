# Copy to .env.local. Values below are the local defaults.

# Postgres (local Supabase, `npm run db:start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email over SMTP. Local: Mailpit (view at http://127.0.0.1:54324).
# Production: any SMTP provider, e.g. smtps://resend:<api-key>@smtp.resend.com:465
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="Talent Biz OS <no-reply@talentbizos.local>"

# Google sign-in (optional locally; the button is hidden when unset).
# Setup steps: docs/setup/google-sign-in.md (redirect URI http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev only: with no Google keys above, 1 enables a stand-in Google that end-to-end tests
# sign in with (lib/auth/config.ts). Ignored in production and when real keys are set.
GOOGLE_TEST_STUB=

# Message analysis (docs/decisions/0006-model-provider.md).
# gemini: GEMINI_API_KEY from Google AI Studio. Its free tier may keep and use what's sent:
#         AI_PROVIDER_KEEPS_DATA=1 shows a notice saying so where people send things in.
# ollama: a local model offline — run `ollama serve` and `ollama pull qwen3:8b`.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_PROVIDER_KEEPS_DATA=1
OLLAMA_URL=http://127.0.0.1:11434

# File storage: Supabase Storage through its S3 API (lib/storage). Locally, copy the values from
# `supabase status -o env` (STORAGE_S3_URL, S3_PROTOCOL_REGION, S3_PROTOCOL_ACCESS_KEY_ID/SECRET).
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=talent-files

# AI usage (docs/decisions/0008). Analyses per account per 24 hours, and per message.
AI_DAILY_ANALYSES=50
AI_MAX_ANALYSES_PER_MESSAGE=4
# Recorded model answers for tests: record = reuse when seen before, else call and save;
# only = never call a model. Ignored in production. Recordings go to AI_RECORDINGS_DIR.
AI_REPLAY=
AI_RECORDINGS_DIR=.ai-recordings

# Local-only OpenAI experiment; leave disabled outside local development.
OPENAI_API_KEY=
AI_LOCAL_EXPERIMENT=0
AI_LOCAL_BUDGET_USD=5
# Set AI_PROVIDER=openai and AI_MODEL=gpt-6-luna to opt in locally.
