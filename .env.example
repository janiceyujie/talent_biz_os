# Copy to .env.local. Values below are the local defaults.

# Which environment this is: development, testing, or production. Unset, it follows NODE_ENV.
# Gates what's for laptops only, such as MAIL_KEY_DEV below.
APP_ENV=development

# Postgres (local Supabase, `npm run db:start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Error reporting (docs/setup/sentry.md). Unset, nothing is sent: leave it unset locally.
# NEXT_PUBLIC_SENTRY_DSN=

# Staging only: one shared password the browser asks for before anything else
# (docs/decisions/0027). Leave unset locally and in production.
# SITE_PASSWORD=

# Production only, during the beta: an account is created only for an email on the
# allowlist (docs/decisions/0028, docs/setup/beta-access.md). WAITLIST_URL is the
# marketing site's waitlist form, linked from the sign-up page.
# SIGNUP_ALLOWLIST=1
# WAITLIST_URL=

# Outgoing email over SMTP. Local: Mailpit (view at http://127.0.0.1:54324).
# Production: any SMTP provider, e.g. smtps://resend:<api-key>@smtp.resend.com:465
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="Taloox <no-reply@taloox.local>"

# Google sign-in (optional locally; the button is hidden when unset).
# Setup steps: docs/setup/google-sign-in.md (redirect URI http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev only: with no Google keys above, 1 enables a stand-in Google that end-to-end tests
# sign in with (lib/auth/config.ts). Ignored in production and when real keys are set.
GOOGLE_TEST_STUB=

# Gmail connection (docs/setup/gmail.md). The local master key that wraps each mailbox's
# token key; development only (deployed environments use Cloud KMS). openssl rand -base64 32
MAIL_KEY_DEV=
# Deployed, Cloud KMS instead (docs/setup/render.md, "Cloud KMS"); set, it replaces MAIL_KEY_DEV.
# GCP_KMS_CREDENTIALS: the web service's may only encrypt, the worker's only decrypt.
# KMS_KEY=projects/<project>/locations/asia-southeast1/keyRings/<ring>/cryptoKeys/<key>
# GCP_KMS_CREDENTIALS=/path/to/service-account.json   # or the JSON itself
# The worker's private endpoint: only the worker can decrypt a mailbox's token, so Intake's
# Waiting and Filtered out ask it for sender and subject (worker/http.ts). Same secret in the
# web service and the worker; openssl rand -base64 32. WORKER_URL is where the web service finds it.
WORKER_SECRET=
WORKER_URL=http://127.0.0.1:3001
# WORKER_HTTP_HOST=127.0.0.1   # where the worker listens; deployed, its private network address
# WORKER_HTTP_PORT=3001
# Jobs at a time: WORKER_CONCURRENCY for most, WORKER_HEAVY_CONCURRENCY for the memory-heavy
# ones (analysis, bringing an email in: heavyJobs in lib/queue/jobs.ts), each in its own pool.
# WORKER_PG_POOL is the database connections both pools share (docs/setup/render.md).
# WORKER_CONCURRENCY=4
# WORKER_HEAVY_CONCURRENCY=2
# WORKER_PG_POOL=6
# Gmail push through Pub/Sub, pulled by the worker (docs/setup/gmail.md, "Push"). All three, or
# none: without them the worker checks each mailbox every 2 minutes. Worker only.
# PUBSUB_TOPIC=projects/<project>/topics/gmail-notices
# PUBSUB_SUBSCRIPTION=projects/<project>/subscriptions/gmail-notices-worker
# GCP_PUBSUB_CREDENTIALS=/path/to/service-account.json   # or the JSON itself

# Message analysis (docs/decisions/0015-production-model-providers.md, 0022-paid-providers-only.md).
# Anthropic as primary, OpenAI as backup (used only when the primary can't answer), in
# development too. Each has a model per role (lib/ai/model.ts); AI_MODEL_<PROVIDER>_<ROLE>
# overrides one, e.g. AI_MODEL_ANTHROPIC_ANALYSIS=claude-sonnet-5-5. Use development keys,
# never production's, with a spending cap on both.
AI_PRIMARY=anthropic
AI_BACKUP=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A mailbox's own calls (scoring each email, reading payment notices) a day; past it, emails
# wait as "Not decided yet" for a later check. Paste, upload, and analysis: AI_DAILY_ANALYSES.
# AI_DAILY_RELEVANCE=500
# The relevance model's score: at or above HIGH is work, below LOW is filtered out, between is
# "Not sure" (lib/mail/relevance/thresholds.ts; set from npm run eval:relevance).
MAIL_RELEVANCE_HIGH=0.6
MAIL_RELEVANCE_LOW=0.4

# File storage: Supabase Storage through its S3 API (lib/storage). Locally, copy the values from
# `supabase status -o env` (STORAGE_S3_URL, S3_PROTOCOL_REGION, S3_PROTOCOL_ACCESS_KEY_ID/SECRET).
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=talent-files

# AI usage (docs/decisions/0008). Analyses per account per 24 hours, and per message.
AI_DAILY_ANALYSES=50
AI_MAX_ANALYSES_PER_MESSAGE=4
# The assistant's questions per person (docs/decisions/0023): a month, from the 1st, and a day
# (a rolling 24 hours, so a burst can't use up the month). Quick prompts don't count.
AI_MONTHLY_ASSISTANT=600
AI_DAILY_ASSISTANT=100
# Pause AI app-wide (lib/ai/pause.ts): nothing is sent to a model; analyses wait and resume on
# their own. By hand with AI_PAUSED=1; on its own when the estimated cost of the last 24 hours
# reaches AI_DAILY_SPEND_CAP_USD (default 20; 0 = no cap), emailing AI_ALERT_EMAIL when set.
# The providers' own monthly limits are the hard cap.
AI_PAUSED=
AI_DAILY_SPEND_CAP_USD=20
AI_ALERT_EMAIL=
# Where the daily read of the opportunity sources reports what went wrong (lib/opportunities/alert.ts):
# a source that failed or changed its format, a tracked page or announcement that couldn't be read.
# Unset: the worker's log only. People using the app never see these.
OPS_ALERT_EMAIL=
# Recorded model answers for tests: record = reuse when seen before, else call and save;
# only = never call a model. Ignored in production. Recordings go to AI_RECORDINGS_DIR.
AI_REPLAY=
AI_RECORDINGS_DIR=.ai-recordings
