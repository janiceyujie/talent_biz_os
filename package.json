{
  "version": "0.1.0",
  "devDependencies": {
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "@types/fontkit": "^2.0.9",
    "@tailwindcss/postcss": "^4",
    "supabase": "^2.119.0",
    "drizzle-kit": "^0.31.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/nodemailer": "^8.0.2",
    "@types/node": "^20",
    "concurrently": "^10.0.6",
    "typescript": "^5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8"
  },
  "scripts": {
    "i18n:check": "node scripts/i18n-check.mjs && tsx scripts/registry-labels-check.mts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx scripts/queue-migrate.mts && tsx --conditions=react-server scripts/publish-templates.mts",
    "db:seed-templates": "tsx --conditions=react-server scripts/seed-document-templates.mts",
    "db:seed-trial": "tsx --conditions=react-server scripts/seed-local-trial.mts",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "dev:web": "next dev",
    "db:stop": "supabase stop",
    "eval:relevance": "tsx --conditions=react-server scripts/eval-relevance.mts",
    "test": "tsx --test 'lib/**/*.test.ts'",
    "start": "next start",
    "db:seed-manager": "tsx --conditions=react-server scripts/seed-manager-trial.mts",
    "lint": "eslint",
    "db:start": "supabase start",
    "eval:extraction": "tsx --conditions=react-server scripts/eval-extraction.mts",
    "eval:assistant": "tsx --conditions=react-server scripts/eval-assistant.mts",
    "build": "next build",
    "dev": "concurrently --names web,worker --prefix-colors blue,green \"npm:dev:web\" \"npm:worker\""
  },
  "name": "talent_biz_os",
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "graphile-worker": "^0.18.0",
    "next": "16.3.8",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5",
    "openai": "^7.38.0",
    "better-auth": "^1.7.7",
    "nodemailer": "^10.0.13",
    "next-intl": "^4.14.9",
    "react-dom": "19.2.8",
    "pdf-lib": "^1.17.1",
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "react": "19.2.8",
    "fontkit": "^2.0.4",
    "pg": "^8.23.1",
    "lucide-react": "^1.49.0",
    "server-only": "^0.0.1",
    "postgres": "^3.4.9",
    "docx": "9.8.1"
  },
  "private": true
}
