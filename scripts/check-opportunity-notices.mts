/** Transaction-only local integration tests; every synthetic row is rolled back. */
import env from '@next/env';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {eq,sql} from 'drizzle-orm';
import type {GrantListing} from '../lib/grants/types';
env.loadEnvConfig(process.cwd());
const url=new URL(process.env.DATABASE_URL||'');
if(process.env.APP_ENV!=='development'||!['127.0.0.1','localhost'].includes(url.hostname)||!/^\/taloox_((merged|integrated|refresh)_\d+|int_20261022_(fresh|upgrade))$/.test(url.pathname))throw Error('local_database_required');
const {db}=await import('../lib/db');
const {person,talent,grantSource,grantApplication,grantWatch,grantChange,notificationState,todo,grantTask}=await import('../lib/db/schema');
const {persistGrantListing}=await import('../lib/grants/persist');
const {getOpportunityNotifications,unreadGrantChanges,listOpportunityChanges,acknowledgeGrantChanges}=await import('../lib/data/grant-changes');
const stop=new Error('rollback_test_fixtures');
try{await db.transaction(async tx=>{
 await tx.insert(grantSource).values({id:"reviewed"}).onConflictDoNothing();
 const now=Date.now(),at=(n:number)=>new Date(now-3600000+n*1000),date=(n:number)=>new Date(now+n*86400000).toISOString().slice(0,10);
 const [p,p2]=await tx.insert(person).values([1,2].map(i=>({email:`opportunity-${randomUUID()}-${i}@example.invalid`,displayName:'Local notice test'}))).returning();
 const [owner,other]=await tx.insert(talent).values([{name:'Local notice fixture',vertical:'music'},{name:'Other isolated fixture',vertical:'music'}]).returning();
 await tx.insert(grantWatch).values({talentId:owner.id,personId:p.id,enabled:true,regions:['TW'],seenAt:at(0)});
 const listing:GrantListing={source:'reviewed',externalId:`notice-test-${randomUUID()}`,region:'TW',title:'Local notice fixture',agency:'Synthetic',url:'https://example.invalid/call',opensOn:date(-1),closesOn:date(10),sourceStatus:'posted',summary:'Synthetic test only',kind:'competition'};
 let row=await persistGrantListing(tx,listing,undefined,at(10));assert.equal(row.noticeRevision,1);
 assert.equal((await unreadGrantChanges(owner.id,p.id,tx))?.count,1,'subscribed new discovery');
 assert.equal((await unreadGrantChanges(other.id,p.id,tx))?.count,0,'other workspace isolated');
 assert.equal((await unreadGrantChanges(owner.id,p2.id,tx))?.count,0,'non-subscriber isolated');
 row=await persistGrantListing(tx,listing,row,at(11));assert.equal(row.noticeRevision,1,'identical daily refresh');
 row=await persistGrantListing(tx,{...listing,summary:'Editorial correction'},row,at(12));assert.equal(row.noticeRevision,1,'copy changes are quiet');
 await acknowledgeGrantChanges(owner.id,p.id,at(12).toISOString(),tx);assert.equal((await unreadGrantChanges(owner.id,p.id,tx))?.count,0);
 const [application]=await tx.insert(grantApplication).values({talentId:owner.id,opportunityId:row.id,createdAt:at(13)}).returning();
 const [plan]=await tx.insert(todo).values({talentId:owner.id,type:'custom',timeZone:'UTC',title:'Synthetic planned submission',dueDate:date(8)}).returning();
 await tx.insert(grantTask).values({applicationId:application.id,todoId:plan.id,kind:'submission'});
 await tx.update(grantWatch).set({enabled:false}).where(eq(grantWatch.personId,p.id));
 row=await persistGrantListing(tx,{...listing,closesOn:date(20)},row,at(14));assert.equal(row.noticeRevision,2);
 assert.equal((await unreadGrantChanges(owner.id,p.id,tx))?.count,1,'tracked extension despite watch disabled');
 assert.equal((await unreadGrantChanges(owner.id,p2.id,tx))?.count,1,'same workspace second person sees their own unread');
 const [changed]=await tx.select().from(grantChange).where(eq(grantChange.revision,2));assert.equal(changed.oldClosesOn,date(10));assert.equal(changed.newClosesOn,date(20));
 await acknowledgeGrantChanges(owner.id,p.id,at(13).toISOString(),tx);assert.equal((await unreadGrantChanges(owner.id,p.id,tx))?.count,1,'newer event survives older snapshot acknowledgement');
 await acknowledgeGrantChanges(owner.id,p.id,at(14).toISOString(),tx);assert.equal((await unreadGrantChanges(owner.id,p.id,tx))?.count,0);assert.equal((await unreadGrantChanges(owner.id,p2.id,tx))?.count,1,'read state is personal');
 row=await persistGrantListing(tx,listing,row,at(15));assert.equal(row.noticeRevision,3,'reversion is a new version');
 row=await persistGrantListing(tx,{...listing,closesOn:date(-1)},row,at(16));assert.equal((await unreadGrantChanges(owner.id,p.id,tx))?.count,2,'shortened deadline stays visible to tracked users');
 row=await persistGrantListing(tx,{...listing,closesOn:null},row,at(17));assert.equal(row.noticeRevision,5,'unknown deadline recorded');
 const [unchangedPlan]=await tx.select().from(todo).where(eq(todo.id,plan.id));assert.equal(unchangedPlan.dueDate,plan.dueDate,'personal planned date untouched');
 for(let n=6;n<=25;n++)row=await persistGrantListing(tx,{...listing,closesOn:date(n+20)},row,at(20+n));
 const first=await listOpportunityChanges(owner.id,p.id,row.id,'',tx);assert.equal(first.items.length,20);assert.ok(first.nextCursor);
 const second=await listOpportunityChanges(owner.id,p.id,row.id,first.nextCursor!,tx);assert.equal(second.items.length,5);assert.equal(new Set([...first.items,...second.items].map(r=>r.id)).size,25);
 await assert.rejects(listOpportunityChanges(other.id,p.id,row.id,first.nextCursor!,tx),'cursor bound to workspace');
 const feed=await getOpportunityNotifications(owner.id,p.id,undefined,tx);assert.equal(feed.length,21);
 const next=await getOpportunityNotifications(owner.id,p.id,[feed[19].date,feed[19].id.split(':')[1]],tx);assert.equal(next.length,4);
 assert.equal(new Set([...feed.slice(0,20),...next].map(n=>n.id)).size,24,'tracked date-change feed pages do not duplicate');
 const latest=next.at(-1)!;await tx.insert(notificationState).values({personId:p.id,notificationId:latest.id,snoozedUntil:new Date(now+3600000)}).onConflictDoUpdate({target:[notificationState.personId,notificationState.notificationId],set:{readAt:null,snoozedUntil:new Date(now+3600000)}});
 const unsnoozed=(await unreadGrantChanges(owner.id,p.id,tx))!.count;await tx.update(notificationState).set({snoozedUntil:at(1)}).where(eq(notificationState.notificationId,latest.id));assert.equal((await unreadGrantChanges(owner.id,p.id,tx))!.count,unsnoozed+1,'snooze returns once due');
 const total=await tx.select({count:sql<number>`count(*)::int`}).from(grantChange).where(eq(grantChange.opportunityId,row.id));assert.equal(total[0].count,25);
 throw stop;
});}catch(e){if(e!==stop)throw e;}
console.log('PASS: versioned persistence, quiet refresh, opt-in discovery, tracked changes, personal read/snooze, snapshot races, 20-row pagination and unchanged submission plans. All fixtures rolled back.');
process.exit(0);
